{
  "id": "order-edit",
  "route": "/orders/:id/edit",
  "datasource": {
    "api": "GET /api/orders/{id}",
    "query": ["id"]
  },
  "permissions": {
    "save": "order:edit",
    "export": "order:export"
  },
  "ui": {
    "type": "form",
    "toolbarActions": ["save", "cancel"]
  },
  "rules": [
    {
      "name": "syncServiceTransport",
      "expr": "serviceSelectionChanged",
      "effect": "syncTransportRecords"
    }
  ],
  "states": ["loading", "ready", "saving", "error"],
  "acceptance": [
    "create_order_generates_placeholder_records",
    "confirm_branch_deletes_linked_service_origin_records",
    "confirm_branch_unchecks_service_from_service_origin_delete",
    "cancel_branch_keeps_service_selection_and_records",
    "source_isolation_transport_origin_changes_do_not_sync_back"
  ],
  "unknowns": []
}
