{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-project/specs/schemas/eval-spec.schema.json",
  "title": "EvalSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "commands", "thresholds", "blockRules", "requiredReports", "testCases", "unknowns"],
  "properties": {
    "scope": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{ "type": "number" }, { "type": "string" }]
      }
    },
    "blockRules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredReports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
