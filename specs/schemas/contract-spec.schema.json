{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-project/specs/schemas/contract-spec.schema.json",
  "title": "ContractSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["featureId", "entities", "transitions", "invariants", "unknowns"],
  "properties": {
    "featureId": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "onConfirm", "onCancel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "if": { "type": "string", "minLength": 1 },
          "confirmText": { "type": "string", "minLength": 1 },
          "onConfirm": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "onCancel": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceScope": {
            "type": "string",
            "enum": ["SERVICE_INFO", "TRANSPORT_INFO", "ALL"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sourceScope": { "const": "ALL" }
              },
              "required": ["sourceScope"]
            },
            "then": {
              "required": ["if"]
            }
          }
        ]
      }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
