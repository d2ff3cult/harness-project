{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-project/specs/schemas/page-spec.schema.json",
  "title": "PageSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "route",
    "datasource",
    "permissions",
    "ui",
    "states",
    "acceptance",
    "unknowns"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "pattern": "^/" },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "query"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "query": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permissions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["table", "form", "detail", "board", "dashboard", "custom"]
        },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rowActions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "toolbarActions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expr", "effect"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expr": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
